{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Igis",
  "version": "0.3.0",
  "identifier": "local.igis.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:39221"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Igis",
        "url": "http://127.0.0.1:39221/connect.html",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
